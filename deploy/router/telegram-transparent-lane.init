#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

SCRIPT=/usr/sbin/telegram-transparent-lane

start_service() {
  # procd keeps retrying after a transient HAOS edge outage or watchdog exit.
  procd_open_instance
  procd_set_param command "$SCRIPT" --watchdog
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

stop_service() {
  :
}

reload_service() {
  stop_service
  start_service
}
