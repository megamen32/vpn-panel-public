[Unit]
Description=Compatibility DNS forwarder for stale LAN DHCP leases
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/vpn-panel/lan-dns-compat.conf
Restart=on-failure
RestartSec=2s
RuntimeDirectory=lan-dns-compat
RuntimeDirectoryMode=0755
CapabilityBoundingSet=CAP_CHOWN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
